{
  "$comment": "https://ajv.js.org/",
  "additionalProperties": false,
  "required": ["max", "min", "name"],
  "properties": {
    "max": {
      "type": "integer",
      "minimum": {
        "$data": "1/min"
      }
    },
    "min": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "name": {
      "minLength": 2,
      "type": "string"
    }
  }
}
